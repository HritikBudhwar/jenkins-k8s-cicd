# Force LF line endings for scripts and config, even on Windows checkouts.
# A shell script with CRLF endings fails inside Linux containers with
# "bad interpreter: /bin/bash^M".
* text=auto eol=lf
*.sh text eol=lf
*.groovy text eol=lf
Jenkinsfile* text eol=lf
*.jar binary
*.png binary
*.bat text eol=crlf
