# ---------------------------------------------------------------------------
# Copy to .env (git-ignored) and fill in:   cp .env.example .env
# These variables are read by docker compose and passed into Jenkins, where
# Configuration-as-Code (jenkins/casc/jenkins.yaml) turns them into the admin
# user and Jenkins credentials. Nothing secret is ever committed.
# ---------------------------------------------------------------------------

# Jenkins admin login (local demo only). Choose a strong password.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=replace-me

# Public URL of Jenkins, used in build links and GitHub commit statuses.
# For a webhook through ngrok, set this to your ngrok https URL.
JENKINS_URL=http://localhost:8080/

# GitHub account and a fine-grained personal access token (see docs/SETUP.md).
# Needed for scanning branches through the GitHub API and reporting
# build status back to commits.
GITHUB_USER=replace-me
GITHUB_TOKEN=replace-me

# Shared secret used to sign webhook payloads (HMAC). Generate it with:
#   openssl rand -hex 20
# Put the same value in the GitHub webhook "Secret" field.
GITHUB_WEBHOOK_SECRET=replace-me

# Repo that holds the shared library (vars/, src/) and the seed config.
# In this project it is the same repo as the sample app.
PLATFORM_REPO_URL=https://github.com/replace-me/jenkins-k8s-cicd.git
PLATFORM_REPO_BRANCH=main
